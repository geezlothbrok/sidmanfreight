# Never bake secrets into the image — the host provides these as environment
# variables, and config.php reads the environment before falling back to a file.
auth_config.php
.env
.env.production
.env.*.local

# Local-only artifacts. Schema is applied to the database out of band, not
# shipped in the running container.
*.sql
uploads/*
!uploads/.gitkeep
.DS_Store
*.log

# Never ship the git metadata or docs into a runtime image.
.git
.gitignore
README.md

# Docs and examples must not ship. Under `php -S` there is no Apache, so the
# .htaccess deny rules below are inert and any non-PHP file in /app is served
# as plaintext. .env.production.example is not secret, but it does disclose the
# manager/finance login addresses and the mailbox — the exact identities an
# attacker needs to target the staff portal.
.env.production.example
auth_config.example.php
.htaccess
Dockerfile
Dockerfile.vercel
