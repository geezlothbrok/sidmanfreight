# Sidman Freight Consult — production environment variables
#
# Set these on the host (Vercel / Render / cPanel). Do NOT deploy
# auth_config.php: config.php reads each of these from the environment first
# and only falls back to that file for local development.
#
# NOTE ON COMMENTS: every comment here is on its own line, never trailing a
# value. `docker run --env-file` does NOT strip trailing comments, so
#     SMTP_PORT=465   # implicit SSL
# assigns the literal string "465   # implicit SSL" to SMTP_PORT.

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require

# Generate with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=REPLACE_ME

# Manager and finance are distinct login identities — see the note below.
# Hash with: php -r "echo password_hash('your-password', PASSWORD_DEFAULT);"
MANAGER_EMAIL=REPLACE_WITH_MANAGER_ADDRESS
MANAGER_PASSWORD_HASH=REPLACE_ME

# Same command, a different password.
FINANCE_EMAIL=REPLACE_WITH_FINANCE_ADDRESS
FINANCE_PASSWORD_HASH=REPLACE_ME

# The site the browser calls the API from. Must match exactly — the CORS
# check and the session cookie both depend on it.
ALLOWED_ORIGIN=https://sidmanfreightconsult.com
COOKIE_SAMESITE=None

# Domain mailbox for the website contact and duty-enquiry forms.
# Port 465 is implicit SSL; on 587 the mailer connects in plaintext and never
# issues STARTTLS, so the password would cross the wire in the clear.
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_USER=REPLACE_WITH_MAILBOX_ADDRESS
SMTP_PASS=REPLACE_WITH_MAILBOX_PASSWORD
CONTACT_TO=REPLACE_WITH_DELIVERY_ADDRESS
